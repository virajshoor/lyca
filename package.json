{
  "name": "ferra-lang",
  "version": "0.1.0",
  "description": "A Python-like, statically typed language that compiles to native code via LLVM",
  "license": "MIT",
  "bin": {
    "ferra": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-runtime.cjs",
    "test": "vitest run",
    "ferra": "node dist/cli/index.js",
    "bench": "npm run build && node benchmarks/run.cjs",
    "test:python": "FERRA_REQUIRE_PYTHON=1 vitest run tests/python.test.ts",
    "bench:python": "npm run build && node benchmarks/python.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
